---
import "../styles/styles.css";
import aulaStyles from "../styles/aula-02.css?url";
interface Props {
  title: string;
  description?: string;
  extraStyles?: boolean;
}
const { title, description = "Caderno pessoal de estudo: matérias, aulas e atividades práticas.", extraStyles = false } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {extraStyles && <link rel="stylesheet" href={aulaStyles} />}
  </head>
  <body><slot /></body>
</html>
