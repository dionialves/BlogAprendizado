---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
interface Props { title: string; description: string; lesson: string; html: string; subjectHref?: string; subjectName?: string; }
const { title, description, lesson, html, subjectHref = "/tecnologias-emergentes-em-engenharia-de-software/", subjectName = "Tecnologias Emergentes em Engenharia de Software" } = Astro.props;
const body = html;
const opening = body.slice(0, body.indexOf("<h2"));
const openingParagraphs = [...opening.matchAll(/<p>([\s\S]*?)<\/p>/g)].map(match => match[1]);
const introduction = openingParagraphs[0] ?? "";
const takeaway = openingParagraphs.slice(1).join("</p><p>");
const sections = [...body.matchAll(/<h2 id="([^"]+)">([\s\S]*?)<\/h2>([\s\S]*?)(?=<h2|$)/g)].map((match, i) => ({
  id: match[1],
  title: match[2].replace(/^\d+\.\s*/, ""),
  content: match[3].replace(/<p><strong>Ideia central:<\/strong>([\s\S]*?)<\/p>/, '<div class="takeaway"><strong>A ideia central</strong><p>$1</p></div>'),
  number: String(i + 1).padStart(2, "0"),
}));
---
<BaseLayout title={title} description={description} extraStyles>
  <div id="progress" aria-hidden="true"></div>
  <SiteHeader lesson fullBrand subjectHref={subjectHref} />
  <div class="layout study-layout">
    <aside>
      <p class="breadcrumb"><a href="/">Todas as matérias</a><br /><a href={subjectHref}>{subjectName}</a></p>
      <span class="eyebrow">NESTE POST</span>
      <nav aria-label="Seções do post">
        {sections.map(section => <a href={`#${section.id}`}><span>{section.number} · </span><Fragment set:html={section.title} /></a>)}
      </nav>
      <p>Leia, aplique e revise.</p>
    </aside>
    <main class="study" id="post-inicio">
      <details class="mobile-index">
        <summary>Neste post</summary>
        <nav aria-label="Seções do post no celular">
          {sections.map(section => <a href={`#${section.id}`}><span>{section.number} · </span><Fragment set:html={section.title} /></a>)}
        </nav>
      </details>
      <section class="hero">
        <span class="eyebrow">AULA AO VIVO {lesson} / GUIA DE ESTUDO</span>
        <h1>{title.split(": ")[0]}:<br /><em>{title.split(": ").slice(1).join(": ")}</em></h1>
        <p class="meta">{subjectName} · Leitura + prática + revisão</p>
        <p class="meta" id="draft-status">Os rascunhos das atividades não são salvos: copie-os antes de sair.</p>
        <p class="lead" set:html={introduction} />
        {takeaway && <div class="takeaway"><strong>A ideia central</strong><p set:html={takeaway} /></div>}
      </section>
      {sections.map(section => <section id={section.id}>
        <span class="eyebrow">{section.number} / AULA AO VIVO {lesson}</span>
        <h2 set:html={section.title} />
        <Fragment set:html={section.content} />
      </section>)}
      <footer><a href={subjectHref}>Voltar aos posts da matéria</a> · <a href="#post-inicio">Voltar ao início</a><br />Caderno pessoal de estudo · Leitura e prática</footer>
    </main>
  </div>
</BaseLayout>
<style>
  .study-layout aside { max-height: calc(100dvh - 64px); overflow-y: auto; padding-top: 40px; padding-right: 8px; padding-bottom: 20px; }
  .study-layout aside nav a { padding: 9px 0; }
  .mobile-index { display: none; }
  .study { overflow-wrap: anywhere; }
  .study :global(figure) { max-width: 560px; margin: 30px auto; }
  .study :global(figure img) { width: 100%; height: auto; }
  .study :global(.table-scroll) { overflow-x: auto; margin: 28px 0; }
  .study :global(th), .study :global(td) { vertical-align: top; }
  .study :global(label) { display: block; font-size: 14px; font-weight: 600; margin-top: 16px; }
  .study :global(textarea) { margin-bottom: 20px; }
  .study :global(blockquote) { margin: 28px 0; border-left: 3px solid var(--accent); padding: 10px 18px; color: var(--muted); }
  .study :global(.takeaway p strong) { font-size: inherit; letter-spacing: normal; text-transform: none; }
  .study :global(.takeaway a), .study :global(.takeaway em) { color: white; }
  .study :global(sup) { font-size: 0.72em; line-height: 0; margin-left: 2px; }
  .study :global(sup a) { text-decoration: none; padding: 2px; }
  .study :global([id^="referencia-"]) { scroll-margin-top: 40px; margin: 16px 0; font-size: 14px; }
  .study :global([id^="citacao-"]) { scroll-margin-top: 40px; }
  .study :global(:target) { outline: 2px solid var(--accent); outline-offset: 4px; }
  #progress { left: 0; width: 0; }
  @media (max-width: 720px) {
    .mobile-index { display: block; margin-top: 24px; }
  }
  @media print {
    .mobile-index, .study :global(textarea), .study :global(.draft-label), #draft-status { display: none !important; }
    .study :global(details summary) { display: none; }
    .study :global(sup a), .study :global([id^="referencia-"]) { color: black; }
    .study :global(.table-scroll) { overflow: visible; }
    .study :global(table) { font-size: 10pt; }
    .study :global(h2), .study :global(h3) { break-after: avoid; }
    .study :global(details) { border: 0; padding: 0; }
  }
</style>
<script>
  import "../scripts/study-post.js";
</script>
